---
layout: null
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": {{ site.description | strip_newlines | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#faf7f1",
  "theme_color": "#7a3b2e",
  "icons": [
    {
      "src": "{{ '/assets/icons/icon-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/icons/icon-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/icons/icon-maskable-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
